
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["user", "admin", "super_admin"], "description": "Роль пользователя в системе" },
        "bio": { "type": "string" },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "address": { "type": "string", "description": "Улица и дом" },
        "floor": { "type": "string" },
        "apartment": { "type": "string" },
        "intercom": { "type": "string", "description": "Код домофона" },
        "addressComment": { "type": "string", "description": "Код калитки, как найти и т.д." },
        "phone": { "type": "string" },
        "bank": { "type": "string", "description": "Банк и реквизиты" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Chat": {
      "title": "Chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemTitle": { "type": "string" },
        "itemImage": { "type": "string" },
        "price": { "type": "number" },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "dealStatus": { "type": "string", "enum": ["pending", "delivered", "received", "completed"] },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "system", "offer", "info"] },
        "offerPrice": { "type": "number" },
        "offerStatus": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "infoData": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "User profiles and contact info."
        }
      },
      {
        "path": "/chats/{chatId}",
        "definition": {
          "entityName": "Chat",
          "schema": { "$ref": "#/backend/entities/Chat" },
          "description": "Chat sessions for deals."
        }
      },
      {
        "path": "/chats/{chatId}/messages/{messageId}",
        "definition": {
          "entityName": "Message",
          "schema": { "$ref": "#/backend/entities/Message" },
          "description": "Messages within a chat."
        }
      },
      {
        "path": "/item_listings/{itemId}",
        "definition": {
          "schema": { "type": "object" },
          "description": "Available items for exchange or sale."
        }
      },
      {
        "path": "/categories/{catId}",
        "definition": {
          "schema": { "type": "object" },
          "description": "Item categories."
        }
      },
      {
        "path": "/settings/branding",
        "definition": {
          "schema": { "type": "object" },
          "description": "Global branding settings like logo."
        }
      }
    ]
  }
}
