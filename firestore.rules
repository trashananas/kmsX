
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // kmsX Security Rules
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-based admin check
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // User profiles and favorites
    match /users/{userId} {
      // Allow authenticated users to see profiles
      allow read: if isSignedIn(); 
      allow write: if isOwner(userId);
      
      match /favorites/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // kmsX Categories - anyone logged in can read/create
    match /categories/{categoryId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // kmsX Item Listings
    match /item_listings/{itemListingId} {
      // Must be logged in to browse kmsX
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Admin roles management
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
