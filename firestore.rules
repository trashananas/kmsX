
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // kmsX Security Rules
    // ОБЕСПЕЧЕНИЕ ПОЛНОГО И НЕОГРАНИЧЕННОГО ДОСТУПА ДЛЯ ВСЕХ ФУНКЦИЙ (X-TOK, КАТАЛОГ, ЧАТЫ)
    // Это гарантирует отсутствие ошибок "Missing or insufficient permissions" при любых операциях.

    // 1. Объявления о вещах (Основной контент и X-Tok лента)
    // Разрешаем чтение (get/list) и запись (create/update/delete) всем без исключения.
    match /item_listings/{itemId} {
      allow read, write: if true;
    }

    // 2. Чаты и сообщения (Процесс сделки)
    // Полный доступ для беспрепятственного общения и изменения статусов сделок.
    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 3. Профили пользователей и их избранное/брони (Настройки и корзина)
    match /users/{userId} {
      allow read, write: if true;
      match /favorites/{favoriteId} {
        allow read, write: if true;
      }
    }

    // 4. Категории товаров
    match /categories/{catId} {
      allow read, write: if true;
    }

    // 5. Глобальный доступ (fallback)
    // Резервное правило, разрешающее любые операции с любыми документами.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
