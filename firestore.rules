
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // РЕЖИМ ПОЛНОЙ ЛОЯЛЬНОСТИ ДЛЯ РАЗРАБОТКИ
    // Разрешаем все операции всем пользователям (даже неавторизованным)
    // Последнее обновление: 2024-05-24 15:00:00
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
