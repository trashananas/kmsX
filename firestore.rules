
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // kmsX Security Rules
    // ОБЕСПЕЧЕНИЕ ПОЛНОГО ДОСТУПА ДЛЯ РЕЖИМА X-TOK И КАТАЛОГА
    // Последнее обновление: 2024-05-24 20:30:00

    // Недвусмысленный доступ к объявлениям для просмотра и редактирования (X-Tok)
    match /item_listings/{itemId} {
      allow read, write: if true;
    }

    // Доступ к чатам и сообщениям для совершения сделок
    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Доступ к категориям
    match /categories/{catId} {
      allow read, write: if true;
    }

    // Доступ к профилям пользователей и их бронированиям/избранному
    match /users/{userId} {
      allow read, write: if true;
      match /favorites/{favoriteId} {
        allow read, write: if true;
      }
    }

    // Резервный доступ для всех остальных данных в режиме разработки
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
