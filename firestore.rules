rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // kmsX Security Rules - ПОЛНЫЙ ДОСТУП
    // Разрешаем чтение и запись для всех коллекций и документов без ограничений.
    // Это необходимо для бесперебойной работы функций каталога, чатов и X-Tok ленты.
    
    match /{document=**} {
      allow read, write: if true;
    }

    // Явное указание для коллекции товаров (на всякий случай)
    match /item_listings/{itemId} {
      allow read, write: if true;
    }

    // Явное указание для чатов и сообщений
    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Явное указание для профилей пользователей и их избранного
    match /users/{userId} {
      allow read, write: if true;
      match /favorites/{favoriteId} {
        allow read, write: if true;
      }
    }
  }
}